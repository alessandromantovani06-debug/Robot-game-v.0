{
  "name": "rift-titans",
  "productName": "Rift Titans",
  "private": true,
  "version": "1.0.0",
  "description": "Rift Titans - costruisci il tuo robot gigante e difendi le citta' dai Kaiju.",
  "author": "Rift Titans",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/generate-icons.mjs",
    "desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --publish never",
    "android": "npm run build && node scripts/prepare-native.mjs android && npx cap open android",
    "ios": "npm run build && node scripts/prepare-native.mjs ios && npx cap open ios"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.rifttitans.game",
    "productName": "Rift Titans",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RiftTitans-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RiftTitans-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "artifactName": "RiftTitans-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "RiftTitans-${version}.${ext}"
    }
  }
}
